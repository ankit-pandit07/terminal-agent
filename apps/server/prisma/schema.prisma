generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ASSISTANT
}

enum ExecutionStatus {
  RUNNING
  SUCCESS
  FAILED
}

model User {
  id              String    @id @default(cuid())
  email           String?   @unique
  phone           String?   @unique
  passwordHash    String?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  name            String?
  avatarUrl       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?

  conversations       Conversation[]
  executions          Execution[]
  memories            AgentMemory[]
  authSessions        AuthSession[]
  passwordResetTokens PasswordResetToken[]

  @@index([email])
  @@index([phone])
}

model OtpVerification {
  id         String    @id @default(cuid())
  identifier String
  channel    String    @default("PHONE")
  purpose    String    @default("LOGIN")
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier, purpose])
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  sessionTokenHash String    @unique
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?
  userAgent        String?
  ipAddress        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionTokenHash])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String?
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   Message[]
  executions Execution[]

  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           Role
  content        String
  attachments    Json?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Execution {
  id             String          @id @default(cuid())
  userId         String?
  conversationId String
  goal           String
  status         ExecutionStatus
  startedAt      DateTime        @default(now())
  finishedAt     DateTime?

  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolExecutions ToolExecution[]

  @@index([userId])
  @@index([conversationId])
}

model ToolExecution {
  id          String   @id @default(cuid())
  executionId String
  tool        String
  input       Json
  output      String
  success     Boolean
  createdAt   DateTime @default(now())

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}

model Session {
  id               String   @id @default(cuid())
  workingDirectory String
  createAt         DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AgentMemory {
  id             String   @id @default(cuid())
  userId         String?
  conversationId String?
  executionId    String?
  type           String
  key            String
  value          String   @db.Text
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([conversationId])
  @@index([executionId])
  @@index([type])
  @@index([key])
}
